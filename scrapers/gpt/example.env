# Copy this file to `.env` in the project root:
#   cp example.env .env
#
# Values in `.env` are used when the matching shell environment
# variable is not already set. CLI flags still win over both.

# Minutes between refreshes in watch mode (default: 15)
GPT_TRACKER_INTERVAL_MINUTES=15

# Directory for latest.json, usage.jsonl, and usage.log (default: ./logs)
GPT_TRACKER_LOG_DIR=./logs

# Codex CLI binary name or absolute path (default: codex)
GPT_TRACKER_CODEX_BIN=codex

# Keep only the newest N snapshots in usage.jsonl and usage.log (default: 5)
GPT_TRACKER_LOG_MAX_RECORDS=5

# POST usage snapshots as JSON. Leave empty to log locally only.
# Multiple endpoints can be comma-separated.
GPT_TRACKER_API_URL=http://localhost:3000/api/chat-gpt

# Request timeout in milliseconds (default: 10000)
GPT_TRACKER_API_TIMEOUT_MS=10000
