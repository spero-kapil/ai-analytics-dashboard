# Refresh interval for daemon mode. Default: 15 minutes.
DEVIN_USAGE_INTERVAL_MINUTES=15

# Directory for usage snapshots. Default: ./logs
# DEVIN_USAGE_LOG_DIR=./logs

# Path to the `devin` executable. Default: looks up `devin` on PATH.
# DEVIN_BIN=devin

# Override credentials file. Default: $XDG_DATA_HOME/devin/credentials.toml
# or ~/.local/share/devin/credentials.toml
# DEVIN_CREDENTIALS_PATH=/home/you/.local/share/devin/credentials.toml

# HTTP timeout for the CLI's GetUserStatus call. Default: 20000
DEVIN_USAGE_TIMEOUT_MS=20000

# Retries after 429 / 5xx / network errors. Default: 5
DEVIN_USAGE_MAX_RETRIES=5

# Initial backoff in milliseconds. Doubles after each failure, capped at 1 hour.
DEVIN_USAGE_BACKOFF_MS=2000

# Abort a hung `devin` subprocess. Default: 20000
DEVIN_CLI_TIMEOUT_MS=20000

# POST each snapshot here. Set to empty to disable.
DEVIN_USAGE_API_URL=http://localhost:3000/api/claude-code

# Optional override for email_id. Default: Email from `devin auth status`.
# DEVIN_ACCOUNT_NAME=

# Timeout for the usage POST. Default: 10000
DEVIN_USAGE_API_TIMEOUT_MS=10000
