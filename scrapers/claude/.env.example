# Copy to .env. The tracker loads this file on startup.
# Precedence: CLI flags > existing shell environment > .env > built-in defaults.

# Refresh interval in minutes (minimum 1)
CLAUDE_USAGE_INTERVAL_MIN=15

# Directory for usage-latest.json, history, and logs
# CLAUDE_USAGE_LOGS_DIR=./logs

# Warn when a usage window is at or above this percent used
CLAUDE_USAGE_WARN_PCT=80

# Critical alert when a usage window is at or above this percent used
CLAUDE_USAGE_CRITICAL_PCT=95

# Claude Code executable name or path
CLAUDE_BIN=claude

# Per-command timeout in seconds
CLAUDE_USAGE_TIMEOUT_SEC=60

# POST each snapshot here. Set to empty to disable.
CLAUDE_USAGE_API_URL=http://localhost:3000/api/claude-code

# Do not set this for subscription tracking. If present, Claude Code may bill
# the API key instead of the Pro/Max plan, and the tracker logs a warning.
# ANTHROPIC_API_KEY=
