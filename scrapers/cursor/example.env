# Copy this file to `.env` in the project root:
#   cp example.env .env
#
# Values in `.env` are used when the matching shell environment
# variable is not already set. CLI flags still win over both.

# Optional override. If unset, the tracker reads the session the
# Cursor app already stored (state DB / keychain / secret-tool).
# cursor.com → DevTools → Application → Cookies → WorkosCursorSessionToken
# CURSOR_SESSION_TOKEN=

# Minutes between refreshes in watch mode / scheduler.js (default: 15)
CURSOR_TRACKER_INTERVAL_MINUTES=15

# Directory for latest.json, usage.jsonl, and cursor.logs (default: ./logs)
CURSOR_TRACKER_LOG_DIR=./logs

# Keep only the newest N snapshots in usage.jsonl and cursor.logs (default: 5)
CURSOR_TRACKER_LOG_MAX_RECORDS=5

# POST usage snapshots as JSON. Leave empty to log locally only.
# Multiple endpoints can be comma-separated.
CURSOR_TRACKER_API_URL=http://localhost:3000/api/cursor

# Request timeout in milliseconds (default: 10000)
CURSOR_TRACKER_API_TIMEOUT_MS=10000
