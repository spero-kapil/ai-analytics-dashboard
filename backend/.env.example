PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=token_tracker
DB_CONNECTION_LIMIT=10

# Legacy MySQL source, only used by `npm run db:migrate-mysql`
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=token_tracker

# Comma-separated list of allowed origins, or * to allow all
# (e.g. chrome-extension://<extension-id>,http://localhost:5173)
CORS_ORIGIN=*
