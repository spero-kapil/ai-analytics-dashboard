{
  "name": "token-tracker-backend",
  "version": "1.0.0",
  "description": "REST API for storing and retrieving AI provider token usage data",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db:init": "node --env-file-if-exists=.env src/db/init.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mysql2": "^3.14.0",
    "pg": "^8.23.1"
  }
}
